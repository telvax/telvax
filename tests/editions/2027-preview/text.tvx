# Edition 2027-preview: the functions of `std.string` are in `std.text`.
fn label(words: List[Text]) -> Text:
    std.text.join(words, "-")

fn test_text_has_join_repeat_and_slice():
    assert_eq(label(["a", "b"]), "a-b")
    assert_eq(std.text.repeat("ab", 2), "abab")
    assert_eq(std.text.slice("hello", 1, 3), "el")
